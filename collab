ario: \")\n","    contrasena = input(\"Contraseña: \")\n","\n","\n","    if (usuario, contrasena) == credenciales:\n","        print(\"\\n✅ Inicio de sesión exitoso\\n\")\n","\n","\n","        # ============================\n","        # Variables principales\n","        # ============================\n","        estudiantes = []\n","        correos = set()\n","        ubicacion_sede = None\n","\n","\n","        # ============================\n","        # Menú principal\n","        # ============================\n","        while True:\n","            print(\"\\n--- MENÚ PRINCIPAL ---\")\n","            print(\"1. Registrar estudiantes\")\n","            print(\"2. Registrar ubicación de la sede\")\n","            print(\"3. Registrar correos\")\n","            print(\"4. Registrar datos detallados de un estudiante\")\n","            print(\"5. Salir\")\n","\n","\n","            opcion = input(\"Selecciona una opción: \")\n","\n","\n","            if opcion == \"1\":\n","                cantidad = pedir_entero(\"¿Cuántos estudiantes quieres registrar? \")\n","                for _ in range(cantidad):\n","                    nombre = input(\"Nombre del estudiante: \")\n","                    estudiantes.append(nombre)\n","                print(\"📋 Lista de estudiantes:\", estudiantes)\n","\n","\n","            elif opcion == \"2\":\n","                latitud = pedir_flotante(\"Ingresa la latitud: \")\n","                longitud = pedir_flotante(\"Ingresa la longitud: \")\n","                ubicacion_sede = (latitud, longitud)\n","                print(\"📍 Ubicación de la sede:\", ubicacion_sede)\n","\n","\n","            elif opcion == \"3\":\n","                cantidad = pedir_entero(\"¿Cuántos correos registrarás? \")\n","                for _ in range(cantidad):\n","                    email = input(\"Correo: \")\n","                    correos.add(email)\n","                print(\"📧 Correos únicos registrados:\", correos)\n","\n","\n","            elif opcion == \"4\":\n","                estudiante = {\n","                    \"nombre\": input(\"Nombre: \"),\n","                    \"edad\": pedir_entero(\"Edad: \"),\n","                    \"carrera\": input(\"Carrera: \"),\n","                    \"notas\": []\n","                }\n","\n","\n","                cantidad_notas = pedir_entero(\"¿Cuántas notas vas a ingresar? \")\n","                for _ in range(cantidad_notas):\n","                    nota = pedir_flotante(\"Nota: \", minimo=0, maximo=5)\n","                    estudiante[\"notas\"].append(nota)\n","\n","\n","                estudiante[\"promedio\"] = sum(estudiante[\"notas\"]) / len(estudiante[\"notas\"])\n","                print(\"📊 Datos del estudiante:\", estudiante)\n","\n","\n","            elif opcion == \"5\":\n","                print(\"👋 Saliendo del programa...\")\n","                break\n","\n","\n","            else:\n","                print(\"⚠ Opción no válida.\")\n","\n","\n","        break  # Rompe el bucle de login después de salir del menú\n","\n","\n","    else:\n","        print(\"❌ Usuario o contraseña incorrectos.\")\n","        reintentar = input(\"¿Intentar de nuevo? (s/n): \").lower()\n","        if reintentar != \"s\":\n","            print(\"👋 Saliendo del programa...\")\n","            break"]}]}
